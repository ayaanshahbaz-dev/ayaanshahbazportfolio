{
  "version": 2,
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "ayaanshahbaz.vercel.app"
        }
      ],
      "headers": {
        "Location": "https://ayaanshahbaz.space/$1"
      },
      "status": 301
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.ayaanshahbaz.space"
        }
      ],
      "headers": {
        "Location": "https://ayaanshahbaz.space/$1"
      },
      "status": 301
    },
    {
      "src": "^/media/?$",
      "has": [
        {
          "type": "host",
          "value": "ayaanshahbaz.space"
        }
      ],
      "headers": {
        "Location": "https://media.ayaanshahbaz.space"
      },
      "status": 301
    },
    {
      "src": "^/media\\.html$",
      "has": [
        {
          "type": "host",
          "value": "ayaanshahbaz.space"
        }
      ],
      "headers": {
        "Location": "https://media.ayaanshahbaz.space"
      },
      "status": 301
    },
    {
      "src": "^/media(/|\\.html)?$",
      "has": [
        {
          "type": "host",
          "value": "media.ayaanshahbaz.space"
        }
      ],
      "headers": {
        "Location": "/"
      },
      "status": 301
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "media.ayaanshahbaz.space"
        }
      ],
      "dest": "/media.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/book-a-meeting/?$",
      "dest": "/book-a-meeting.html"
    },
    {
      "src": "^/automation-library/?$",
      "dest": "/automation-library.html"
    },
    {
      "src": "^/media/?$",
      "dest": "/media.html"
    }
  ]
}